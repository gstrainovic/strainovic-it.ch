{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "strainovic-it-ch",
  "compatibility_date": "2026-09-12",
  "assets": {
    // Ausgabe von `npm run generate`.
    "directory": "./.output/public",
    // Bei unbekannten Pfaden die erzeugte 404.html ausliefern.
    "not_found_handling": "404-page",
    // Mit Schrägstrich am Ende, so wie Netlify die Seiten ausliefert und
    // wie sie in Links und sitemap.xml stehen. Bei einem Hosterwechsel
    // bleiben die Adressen damit gleich.
    "html_handling": "force-trailing-slash"
  }
}
