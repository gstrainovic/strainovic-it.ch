# Weiterleitungen fuer Cloudflare Pages. Reihenfolge zaehlt: die erste
# passende Regel gewinnt, deshalb stehen genaue Pfade vor den Platzhaltern.

# Die englische Fassung entfaellt, die Seite ist einsprachig deutsch.
/en                            /             301
/en/about                      /profil       301
/en/contact                    /kontakt      301
/en/privacy-policy             /datenschutz  301
/en/imprint                    /impressum    301
/services                      /profil       301
/services/*                    /profil       301
/portfolio                     /referenzen   301
/portfolio/*                   /referenzen   301
/en/*                          /             301

# Dienstleistungen und Ueber uns sind im Profil aufgegangen.
/dienstleistungen              /profil       301
/dienstleistungen/*            /profil       301
/ueber-uns                     /profil       301
/ueber-uns/*                   /profil       301

# Portfolio heisst jetzt Referenzen.
/referenzen-und-portfolio      /referenzen   301
/referenzen-und-portfolio/*    /referenzen   301
