# Weiterleitungen der alten Adressen. Cloudflare wertet diese Datei aus,
# sie wird selbst nicht ausgeliefert. Feste Pfade stehen vor den
# Platzhaltern, so empfiehlt es Cloudflare.

# Adressen der alten englischen Fassung. Die neue liegt unter /en/ mit
# denselben Pfaden wie die deutsche.
/en/about                      /en/profil/       301
/en/contact                    /en/kontakt/      301
/en/privacy-policy             /en/datenschutz/  301
/en/imprint                    /en/impressum/    301
/en/services                   /en/profil/       301
/en/portfolio                  /en/referenzen/   301
/services                      /profil/       301
/portfolio                     /referenzen/   301

# Dienstleistungen und Ueber uns sind im Profil aufgegangen.
/dienstleistungen              /profil/       301
/ueber-uns                     /profil/       301

# Portfolio heisst jetzt Referenzen.
/referenzen-und-portfolio      /referenzen/   301

# Unterseiten der aufgeloesten Bereiche.
/en/services/*                 /en/profil/       301
/en/portfolio/*                /en/referenzen/   301
/services/*                    /profil/       301
/portfolio/*                   /referenzen/   301
/dienstleistungen/*            /profil/       301
/ueber-uns/*                   /profil/       301
/referenzen-und-portfolio/*    /referenzen/   301
